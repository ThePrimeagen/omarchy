# File system
if command -v eza &> /dev/null; then
  unalias ls 2>/dev/null || true
  ls() {
    local args=() arg stripped after_dashdash=0 reversed=0 scan_dashdash=0
    for arg in "$@"; do
      if (( scan_dashdash )); then
        continue
      elif [[ $arg == "--" ]]; then
        scan_dashdash=1
      elif [[ $arg == "--reverse" ]]; then
        reversed=1
      elif [[ $arg == -*r* && $arg != --* ]]; then
        reversed=1
      fi
    done
    for arg in "$@"; do
      if (( after_dashdash )); then
        args+=("$arg")
      elif [[ $arg == "--" ]]; then
        after_dashdash=1
        args+=("$arg")
      elif [[ $arg == "-t" ]]; then
        args+=(--sort=modified)
        (( reversed )) || args+=(--reverse)
      elif [[ $arg == -*t* && $arg != --* ]]; then
        stripped="-${arg#-}"
        stripped="${stripped//t}"
        [[ $stripped == "-" ]] || args+=("$stripped")
        args+=(--sort=modified)
        (( reversed )) || args+=(--reverse)
      else
        args+=("$arg")
      fi
    done
    eza -lh --group-directories-first --icons=auto "${args[@]}"
  }
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

if [[ "$TERM" == "xterm-kitty" ]]; then
  alias ff="fzf --preview 'case \$(file --mime-type -b {}) in image/*) kitty icat --clear --transfer-mode=memory --stdin=no --place=\${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES}@0x0 {} ;; *) bat --style=numbers --color=always {} ;; esac'"
else
  alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
fi
unalias eff 2>/dev/null || true
eff() { local file; file=$(ff) && [[ -n $file ]] && $EDITOR "$file" "$@"; }
sff() { if [ $# -eq 0 ]; then echo "Usage: sff <destination> (e.g. sff host:/tmp/)"; return 1; fi; local file; file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | ff) && [ -n "$file" ] && scp "$file" "$1"; }

if command -v zoxide &> /dev/null; then
  alias cd="zd"
  zd() {
    if (( $# == 0 )); then
      builtin cd ~ || return
    elif [[ -d $1 ]]; then
      builtin cd "$1" || return
    else
      if ! z "$@"; then
        echo "Error: Directory not found"
        return 1
      fi

      printf "\U000F17A9 "
      pwd
    fi
  }
fi

open() (
  xdg-open "$@" >/dev/null 2>&1 &
)

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tools
alias a='omarchy-agent --inline'
alias c='opencode --auto'
alias cx='printf "\033[2J\033[3J\033[H" && claude --permission-mode auto'
alias cy='codex --approve-for-me'
alias d='docker'
alias r='rails'
alias t='tmux attach || tmux new -s Work'
alias h='herdr'
alias ic='tdl c'
alias ix='tdl cx'
alias icx='tdl c cx'
alias mup='MISE_MINIMUM_RELEASE_AGE=0 mise up'
n() { if [ "$#" -eq 0 ]; then command nvim . ; else command nvim "$@"; fi; }

# Git
alias g='git'
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'
