# Create a new worktree and branch from within current git directory.
ga() {
  if [[ -z "$1" ]]; then
    echo "Usage: ga [branch name]"
    return 1
  fi

  local branch="$1"
  local base="$(basename "$PWD")"
  local wt_path="../${base}--${branch}"

  git worktree add -b "$branch" "$wt_path"
  mise trust "$wt_path"
  cd "$wt_path"
}

# Remove worktree and branch from within active worktree directory.
gd() {
  if gum confirm "Remove worktree and branch?"; then
    local worktree branch main

    worktree="$(git rev-parse --show-toplevel 2>/dev/null)"
    branch="$(git branch --show-current 2>/dev/null)"
    main="$(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -n 1)"

    # Protect against accidentally nuking a non-worktree directory
    if [[ -n "$worktree" && "$worktree" != "$main" ]]; then
      cd "$main"
      git worktree remove "$worktree" --force || return 1
      [[ -n "$branch" ]] && git branch -D "$branch"
    fi
  fi
}
