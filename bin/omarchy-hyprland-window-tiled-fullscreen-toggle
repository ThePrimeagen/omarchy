#!/bin/bash

# omarchy:summary=Toggle tiled fullscreen for the focused Hyprland window

set -euo pipefail

active=$(hyprctl activewindow -j)
fullscreen=$(jq -r '.fullscreen // 0' <<<"$active")

if (( fullscreen & 2 )); then
  hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "fullscreen", action = "unset" })' >/dev/null 2>&1 || \
    hyprctl dispatch fullscreenstate 0 0 >/dev/null
else
  hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "fullscreen", action = "set" })' >/dev/null 2>&1 || \
    hyprctl dispatch fullscreenstate 0 2 >/dev/null
fi
