#!/bin/bash

# omarchy:summary=Run Claude, Codex, or Grok as the selected subscription account
# omarchy:args=<claude|codex|grok> [args...]
# omarchy:hidden=true

set -euo pipefail

case "${1:-}" in
  claude) account_env="CLAUDE_CONFIG_DIR" ;;
  codex) account_env="CODEX_HOME" ;;
  grok) account_env="GROK_HOME" ;;
  *)
    echo "Usage: omarchy-agent-account-exec <claude|codex|grok> [args...]" >&2
    exit 1
    ;;
esac

provider=$1
shift

# mise removes its wrapper dispatch directories before calling us, so exec
# finds the real CLI (or its first-run installer) rather than this wrapper.
# Pin the resolved home for children, including an implicit Main account.
# Explicit provider homes still take precedence.
if [[ -z ${!account_env:-} ]]; then
  account_home=$(omarchy-agent-account-home "$provider")
  export "OMARCHY_AGENT_${provider^^}_HOME=$account_home"
  if [[ -n $account_home ]]; then
    export "$account_env=$account_home"
  fi
fi

# Resolve before restoring dispatch on PATH: mise removes the wrapper paths to
# avoid recursion, but the agent's subprocesses need them for other providers.
# omarchy-mise-install's wrappers run `mise use` and `mise x`, current ones on
# lines of their own and older ones after an inline variable; either way
# running one installs the tool it wraps. A symlink is the user's own install.
mise_wrapper() {
  [[ ! -L $1 ]] && head -c 4096 "$1" | grep -qaE 'mise (use|x) '
}

# The user's own install in ~/.local/bin, which omarchy-default-agent counts as
# installed, still wins over mise's lazy shim earlier on PATH, which would
# install and run mise's copy instead. Once mise has installed its own, a
# terminal runs that one, so dispatch does too.
user_install="$HOME/.local/bin/$provider"
if [[ -f $user_install && -x $user_install ]] &&
  ! mise_wrapper "$user_install" && ! MISE_OFFLINE=1 mise which "$provider" &>/dev/null; then
  agent_binary=$user_install
elif ! agent_binary=$(type -P "$provider"); then
  # A mise dispatcher can exist before its CLI or first-run installer does.
  # Omarchy declares these agents, so installing one leaves the user's config
  # alone. A user who removed the preinstalls selects it in their own config.
  export MISE_MINIMUM_RELEASE_AGE=0
  if omarchy-mise-default-tools declares "$provider"; then
    mise install --quiet "$provider"
  else
    mise use -g --quiet "$provider"
  fi
  agent_binary=$(mise which "$provider")
fi
# mise also drops its shims, leaving only the tools installed at launch. A
# long-lived agent needs them back to find tools installed after it started.
mise_data_dir=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}
PATH="$mise_data_dir/command-wrappers/bin:$PATH"
if [[ :$PATH: != *":$mise_data_dir/shims:"* ]]; then
  PATH="$PATH:$mise_data_dir/shims"
fi
export PATH
exec "$agent_binary" "$@"
