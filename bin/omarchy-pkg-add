#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

if omarchy-pkg-missing "$@"; then
  if (( EUID == 0 )); then
    pacman -S --noconfirm --needed -- "$@" || exit 1
  else
    # Bash holds a trap until a foreground command finishes, and sudo ignores
    # Ctrl-C at its password prompt. Running sudo in the background behind a
    # `wait` lets Ctrl-C stop it at once.
    child_pid=""
    trap '[[ -z $child_pid ]] || kill "$child_pid" 2>/dev/null; exit 130' INT TERM
    sudo pacman -S --noconfirm --needed -- "$@" <&0 &
    child_pid=$!
    wait "$child_pid" || exit 1
    child_pid=""
    trap - INT TERM
  fi
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q -- "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
